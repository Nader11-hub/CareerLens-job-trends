# Runtime
ENV=development
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=careerlens.log

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=careerlens
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Data sources
REMOTIVE_API_URL=https://remotive.com/api/remote-jobs
KAGGLE_FALLBACK_PATH=data/fallback/kaggle_fallback.csv

# Serving
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# Pipeline behavior
BRONZE_SCHEMA=public
SILVER_SCHEMA=public
GOLD_SCHEMA=public

# Near-real-time scheduling
# Controls how often the scheduled pipeline re-runs (in minutes).
# Default is 5 minutes — intentionally a short-interval batch pipeline, not streaming.
# Job postings update on the order of hours; 5-min cycles keep the dashboard fresh.
# Increase to 60 for production to reduce API load.
PIPELINE_INTERVAL_MINUTES=5
