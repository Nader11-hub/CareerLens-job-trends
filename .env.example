# Runtime
ENV=development
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=careerlens.log

# MySQL Configuration
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DB=careerlens
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Database connection URL
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/careerlens?charset=utf8mb4

# Data sources
REMOTIVE_API_URL=https://remotive.com/api/remote-jobs
KAGGLE_FALLBACK_PATH=data/fallback/kaggle_fallback.csv

# Serving
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# Pipeline behavior
BRONZE_SCHEMA=public
SILVER_SCHEMA=public
GOLD_SCHEMA=public

# Near-real-time scheduling
# Controls how often the scheduled pipeline re-runs (in minutes).
# Default is 5 minutes — intentionally a short-interval batch pipeline, not streaming.
# Job postings update on the order of hours; 5-min cycles keep the dashboard fresh.
# Increase to 60 for production to reduce API load.
PIPELINE_INTERVAL_MINUTES=5

# Email Alerts (SMTP) — for daily job digest notifications
# Use Gmail with an App Password (https://myaccount.google.com/apppasswords)
# Leave SMTP_USER empty to disable email sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_NAME=CareerLens Alerts

# JSearch / RapidAPI — 4th live job source (thousands of global jobs)
# Sign up free at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Leave JSEARCH_API_KEY empty to disable this source (it will be skipped gracefully)
JSEARCH_API_KEY=your_rapidapi_key_here
JSEARCH_API_URL=https://jsearch.p.rapidapi.com/search

# Authentication (JWT)
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=careerlens-secret-key-change-in-production-2024
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Default Admin Account (auto-seeded on first run — CHANGE THESE!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@careerlens.io
